---
// レイアウトコンポーネント。全ページ共通の<head>とヘッダーナビをここにまとめている。
// 各pages/*.astroは <Layout title="..."> 中身 </Layout> という形で必ずこれを経由する。
import "../styles/global.css";
import { profile } from "../data/profile";

// このコンポーネントが受け取るprops(呼び出し側から渡される値)の型定義
interface Props {
  title: string; // <title>タグ・ブラウザタブに出るページタイトル
}

const { title } = Astro.props;

// 現在のパスに応じて、ヘッダーナビのどの項目を強調表示するかを決める。
// /works や /articles の配下ページ(例: /works/xxx)でも一覧側を強調させたいので startsWith で判定する。
const path = Astro.url.pathname;
const isWorksActive = path.startsWith("/works");
const isArticlesActive = path.startsWith("/articles");
const isProfileActive = !isWorksActive && !isArticlesActive;
---

<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
  </head>
  <body>
    <!-- 全ページ共通のヘッダーナビ。文言やリンク先を変えたい場合はここを直接編集する -->
    <header class="site-header">
      <nav>
        <a class:list={{ active: isProfileActive }} href="/">プロフィール</a>
        <a class:list={{ active: isWorksActive }} href="/works">制作物</a>
        <a class:list={{ active: isArticlesActive }} href="/articles">記事</a>
      </nav>
    </header>
    <main>
      <!-- <slot /> = 各ページ側で<Layout>...</Layout>の中に書いた中身がここに差し込まれる -->
      <slot />
    </main>
  </body>
</html>

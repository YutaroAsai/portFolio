---
import Layout from "../../layouts/Layout.astro";
import { getCollection } from "astro:content";
import { profile } from "../../data/profile";

const isDev = import.meta.env.DEV;
const articles = (
  await getCollection("articles", ({ data }) => isDev || !data.draft)
).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---

<Layout title={`記事一覧 | ${profile.name}`}>
  <section>
    <h2>記事一覧</h2>
    {
      articles.length === 0 ? (
        <p>準備中です。</p>
      ) : (
        <div class="work-grid">
          {articles.map((article) => (
            <a
              class="work-card"
              href={article.data.externalUrl ?? `/articles/${article.id}`}
              target={article.data.externalUrl ? "_blank" : undefined}
              rel={article.data.externalUrl ? "noopener noreferrer" : undefined}
            >
              <h3>
                {article.data.title}
                {article.data.draft && <span class="draft-badge">draft</span>}
              </h3>
              <p>{article.data.summary}</p>
              <time datetime={article.data.date.toISOString()}>
                {article.data.date.toISOString().slice(0, 10)}
              </time>
              {article.data.externalUrl && (
                <ul class="tag-list">
                  <li>Zenn</li>
                </ul>
              )}
            </a>
          ))}
        </div>
      )
    }
  </section>
</Layout>

---
import Layout from "../layouts/Layout.astro";
import { profile } from "../data/profile";
import { getCollection } from "astro:content";

const isDev = import.meta.env.DEV;
const allWorks = await getCollection(
  "works",
  ({ data }) => isDev || !data.draft,
);
const recentWorks = allWorks
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);

const allArticles = await getCollection(
  "articles",
  ({ data }) => isDev || !data.draft,
);
const recentArticles = allArticles
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);
---

<Layout title={`${profile.name} | Portfolio`}>
  <section id="profile">
    <h1>{profile.name}</h1>
    <p>{profile.role}</p>
    <p>{profile.summary}</p>
    <ul class="skills">
      {profile.skills.map((skill) => <li>{skill}</li>)}
    </ul>
    <div class="work-links">
      <a href={profile.links.zenn} target="_blank" rel="noopener noreferrer">Zenn</a>
      <a href={profile.links.github} target="_blank" rel="noopener noreferrer">GitHub</a>
    </div>
  </section>

  <section id="articles">
    <h2>記事</h2>
    {
      recentArticles.length === 0 ? (
        <p>準備中です。</p>
      ) : (
        <div class="work-grid">
          {recentArticles.map((article) => (
            <a
              class="work-card"
              href={article.data.externalUrl ?? `/articles/${article.id}`}
              target={article.data.externalUrl ? "_blank" : undefined}
              rel={article.data.externalUrl ? "noopener noreferrer" : undefined}
            >
              <h3>
                {article.data.title}
                {article.data.draft && <span class="draft-badge">draft</span>}
              </h3>
              <p>{article.data.summary}</p>
            </a>
          ))}
        </div>
      )
    }
    <a class="more" href="/articles">記事一覧を見る →</a>
  </section>

  <section id="works">
    <h2>制作物</h2>
    {
      recentWorks.length === 0 ? (
        <p>準備中です。</p>
      ) : (
        <div class="work-grid">
          {recentWorks.map((work) => (
            <a class="work-card" href={`/works/${work.id}`}>
              <div class="thumb">
                {work.data.thumbnail ? (
                  <img
                    src={work.data.thumbnail}
                    alt=""
                    style="width:100%;height:100%;object-fit:cover;border-radius:4px;"
                  />
                ) : (
                  "構成図準備中"
                )}
              </div>
              <h3>
                {work.data.title}
                {work.data.draft && <span class="draft-badge">draft</span>}
              </h3>
              <p>{work.data.summary}</p>
            </a>
          ))}
        </div>
      )
    }
    <a class="more" href="/works">制作物一覧を見る →</a>
  </section>
</Layout>
